# Sao chép thành .env.local rồi sửa theo máy của bạn (.env.local không được commit)

# Tiền tố mọi request API. Dev: "/api" (đi qua proxy của Vite). Prod: URL của API Gateway.
VITE_API_BASE_URL=/api

# true: dùng dữ liệu giả trong src/mocks, không cần bật backend
VITE_USE_MOCK=true

# Đích proxy /api khi chạy `npm run dev`: fd-auth-service (:8081), hoặc fd-gateway-service (:8080) khi có thêm
# service khác
VITE_PROXY_TARGET=http://localhost:8081

# OpenAPI (springdoc) mà Orval đọc để sinh code
ORVAL_AUTH_SPEC=http://localhost:8081/v3/api-docs
