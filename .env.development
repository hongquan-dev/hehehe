# Giá trị mặc định khi chạy `npm run dev`. Ghi đè riêng cho máy bạn trong .env.local

# Tiền tố mọi request API. Dev: "/api" (đi qua proxy của Vite). Prod: URL của API Gateway.
VITE_API_BASE_URL=/api

# true: dùng dữ liệu giả trong src/mocks, không cần bật backend. false: gọi backend thật (cần chạy
# fd-auth-service :8081)
VITE_USE_MOCK=false

# Đích proxy /api khi chạy `npm run dev`. Hiện frontend chỉ gọi API /auth/** nên trỏ thẳng fd-auth-service; khi có
# thêm service khác thì đổi sang fd-gateway-service (http://localhost:8080)
VITE_PROXY_TARGET=http://localhost:8081

# OpenAPI (springdoc) mà Orval đọc để sinh code
ORVAL_AUTH_SPEC=http://localhost:8081/v3/api-docs
